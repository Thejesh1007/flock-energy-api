
{
  "openapi": "3.0.3",
  "info": {
    "title": "Flock Energy — Urja Meter Ops API",
    "version": "1.0.0",
    "description": "REST API wrapper around the legacy Urja Meter Ops portal. Portal authentication is handled by the service using credentials configured in environment variables."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server (change PORT to configure the port)"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Service health"
    },
    {
      "name": "Meters",
      "description": "Meter search, details, and consumption history"
    },
    {
      "name": "Transformers",
      "description": "Distribution transformer data"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Check service health",
        "responses": {
          "200": {
            "description": "The API process is responding",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "tags": ["Meters"],
        "summary": "List or search meters",
        "description": "Returns the portal's paginated meter results. Search text can match a meter ID or serial number.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search query for a meter ID or serial number",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "$ref": "#/components/parameters/Page"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated meter results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterPage"
                },
                "example": {
                  "data": [
                    {
                      "meterId": "J100000",
                      "serialNo": "SE33962",
                      "make": "HPL",
                      "phaseType": "single",
                      "installStatus": "Decommissioned",
                      "dtCode": "DT-001"
                    }
                  ],
                  "total": 403,
                  "page": 1,
                  "pageSize": 20
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "502": {
            "$ref": "#/components/responses/PortalFailure"
          },
          "503": {
            "$ref": "#/components/responses/MissingCredentials"
          }
        }
      }
    },
    "/api/v1/meters/{id}": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get a meter's details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Exact meter ID returned by the meter search endpoint",
            "schema": {
              "type": "string",
              "example": "J100000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meter details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Meter"
                },
                "example": {
                  "meterId": "J100000",
                  "serialNo": "SE33962",
                  "make": "HPL",
                  "phaseType": "single",
                  "installStatus": "Decommissioned",
                  "dtCode": "DT-001"
                }
              }
            }
          },
          "404": {
            "description": "No meter with this ID was found in the search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Meter UNKNOWN-ID not found."
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/PortalFailure"
          },
          "503": {
            "$ref": "#/components/responses/MissingCredentials"
          }
        }
      }
    },
    "/api/v1/meters/{id}/consumption": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get a meter's consumption history",
        "description": "Returns consumption readings normalized to ISO 8601 timestamps and numeric values where conversion is possible.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Meter ID used by the portal's energy endpoint",
            "schema": {
              "type": "string",
              "example": "J100000"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consumption readings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsumptionResponse"
                },
                "example": {
                  "meterId": "J100000",
                  "readings": [
                    {
                      "timestamp": "2026-06-23T23:30:00.000Z",
                      "kwh": 48438.74,
                      "kvah": 52313.84,
                      "voltageR": 226
                    }
                  ]
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/PortalFailure"
          },
          "503": {
            "$ref": "#/components/responses/MissingCredentials"
          }
        }
      }
    },
    "/api/v1/transformers": {
      "get": {
        "tags": ["Transformers"],
        "summary": "List distribution transformers",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated transformer results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransformerPage"
                },
                "example": {
                  "data": [
                    {
                      "dtCode": "DT-001",
                      "name": "Malviya Nagar DT 1",
                      "feeder": "F-001",
                      "capacityKva": 100
                    }
                  ],
                  "total": 20,
                  "page": 1,
                  "pageSize": 20
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "502": {
            "$ref": "#/components/responses/PortalFailure"
          },
          "503": {
            "$ref": "#/components/responses/MissingCredentials"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "1-based page number; must be a positive integer",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable error message"
          }
        }
      },
      "Meter": {
        "type": "object",
        "description": "Meter fields returned by the legacy portal. Additional portal fields may be present.",
        "properties": {
          "meterId": {
            "type": "string",
            "example": "J100000"
          },
          "serialNo": {
            "type": "string",
            "example": "SE33962"
          },
          "make": {
            "type": "string",
            "example": "HPL"
          },
          "phaseType": {
            "type": "string",
            "example": "single"
          },
          "installStatus": {
            "type": "string",
            "example": "Decommissioned"
          },
          "dtCode": {
            "type": "string",
            "example": "DT-001"
          }
        },
        "additionalProperties": true
      },
      "MeterPage": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Meter"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      },
      "ConsumptionReading": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "kwh": {
            "type": "number",
            "nullable": true
          },
          "kvah": {
            "type": "number",
            "nullable": true
          },
          "voltageR": {
            "type": "number",
            "nullable": true
          }
        },
        "additionalProperties": true
      },
      "ConsumptionResponse": {
        "type": "object",
        "required": ["meterId", "readings"],
        "properties": {
          "meterId": {
            "type": "string"
          },
          "readings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsumptionReading"
            }
          }
        }
      },
      "Transformer": {
        "type": "object",
        "description": "Transformer fields returned by the legacy portal.",
        "properties": {
          "dtCode": {
            "type": "string",
            "example": "DT-001"
          },
          "name": {
            "type": "string",
            "example": "Malviya Nagar DT 1"
          },
          "feeder": {
            "type": "string",
            "example": "F-001"
          },
          "capacityKva": {
            "type": "number",
            "example": 100
          }
        },
        "additionalProperties": true
      },
      "TransformerPage": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transformer"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The page parameter is not a positive integer",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "page must be a positive integer."
            }
          }
        }
      },
      "PortalFailure": {
        "description": "The upstream portal could not be reached, returned an unexpected response, or rejected the request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Portal request failed with status 500"
            }
          }
        }
      },
      "MissingCredentials": {
        "description": "Portal credentials are not configured",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Portal credentials are missing. Configure PORTAL_USERNAME and PORTAL_PASSWORD in .env."
            }
          }
        }
      }
    }
  }
}
